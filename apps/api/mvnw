#!/bin/sh
# Maven Wrapper (minimal) - downloads Maven on demand.

set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
JAR="$WRAPPER_DIR/maven-wrapper.jar"
PROPS="$WRAPPER_DIR/maven-wrapper.properties"

if [ ! -f "$PROPS" ]; then
  echo "Missing $PROPS" 1>&2
  exit 1
fi

if [ ! -f "$JAR" ]; then
  mkdir -p "$WRAPPER_DIR"
  WRAPPER_URL=$(grep -E '^wrapperUrl=' "$PROPS" | sed 's/^wrapperUrl=//')
  if [ -z "${WRAPPER_URL:-}" ]; then
    echo "Missing wrapperUrl in $PROPS" 1>&2
    exit 1
  fi
  echo "Downloading Maven Wrapper jar..." 1>&2
  curl -fsSL "$WRAPPER_URL" -o "$JAR"
fi

exec java -classpath "$JAR" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" org.apache.maven.wrapper.MavenWrapperMain "$@"

